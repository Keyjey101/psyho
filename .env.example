# AI Provider (ZAI/GLM)
ZAI_API_KEY=your-zai-api-key
ZAI_BASE_URL=https://api.zai.chat/v1
ZAI_MODEL=glm-5
ZAI_SMALL_MODEL=glm-4-flash

# Security
SECRET_KEY=generate-with-openssl-rand-hex-32
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=30
ALLOWED_ORIGINS=https://yourdomain.com

# Admin (comma-separated emails and/or Telegram usernames)
ADMIN_EMAILS=your@email.com
ADMIN_TELEGRAM_USERNAMES=your_tg_username

# SMTP
SMTP_DOMAIN=ekbmassage.online
SMTP_FROM=noreply@ekbmassage.online

# App
APP_PORT=8080
ENVIRONMENT=production
DATABASE_URL=sqlite+aiosqlite:////data/psyho.db

# Telegram bot (notifications, OTP, /link)
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
VITE_TG_BOT_USERNAME=

# ── Monetization ──────────────────────────────────────────────────────
# Master switch. Until true: paywall/quota checks are bypassed,
# /api/billing/subscribe and /api/billing/package return 503.
MONETIZATION_ENABLED=false

# Prices in kopecks (RUB × 100). Floats banned to avoid rounding pain.
PRICING_PRO_MONTH_KOPECKS=39000
PRICING_PRO_3M_KOPECKS=99000
PRICING_PRO_YEAR_KOPECKS=299000
PRICING_PACK_5_KOPECKS=29000
PRICING_PACK_15_KOPECKS=69000

# Free tier limits
FREE_LIFETIME_SESSIONS=2
FREE_DAILY_ACTIONS=1

# Pack sizes (sessions credited per purchase)
PACK_5_SIZE=5
PACK_15_SIZE=15

# WebSocket message rate limits per minute
WS_RATE_LIMIT_FREE=20
WS_RATE_LIMIT_PRO=60
WS_RATE_LIMIT_PACKAGE=30

# ЮKassa — leave empty to disable real payments (admin can still grant manually)
YOOKASSA_SHOP_ID=
YOOKASSA_SECRET_KEY=
YOOKASSA_RETURN_URL=https://yourdomain.com/profile/subscription?from=yookassa

# Subscription renewal job
SUBSCRIPTION_GRACE_DAYS=3
SUBSCRIPTION_RENEW_LOOKAHEAD_HOURS=24
